---
import { getCollection } from "astro:content";
import ProjectCard from "./ProjectCard.astro";
import { ui, type Lang } from "../i18n/ui";

interface Props {
  lang?: Lang;
}

const { lang = "en" } = Astro.props;
const t = ui[lang].projects;

const projects = (await getCollection("projects", ({ id }) => id.startsWith(`${lang}/`))).sort(
  (a, b) => a.data.order - b.data.order,
);

const counts = {
  all: projects.length,
  ai: projects.filter((p) => p.data.category === "ai").length,
  web: projects.filter((p) => p.data.category === "web").length,
};
const filters = ["all", "ai", "web"] as const;
---

<section class="section" id="projects" aria-labelledby="projects-title">
  <div class="wrap">
    <header class="sec-head">
      <span class="sec-tag">{t.tag}</span>
      <h2 id="projects-title">{t.title}</h2>
      <p>{t.intro}</p>
    </header>

    <div class="filters" role="group" aria-label={t.filtersLabel}>
      {
        filters.map((f) => (
          <button class="filter-btn" type="button" data-filter={f} aria-pressed={f === "all" ? "true" : "false"}>
            {t.filters[f]}
            <span class="count">{counts[f]}</span>
          </button>
        ))
      }
    </div>

    <p class="result-count" aria-live="polite" data-showing={t.showing} data-of={t.of} data-total={projects.length}>
      {t.showing} {projects.length} {t.of} {projects.length}
    </p>

    <div class="project-list">
      {projects.map((project, i) => <ProjectCard project={project} index={i} lang={lang} />)}
    </div>
  </div>
</section>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>("[data-filter]");
  const cards = document.querySelectorAll<HTMLElement>(".project[data-category]");
  const counter = document.querySelector<HTMLElement>(".result-count");

  buttons.forEach((btn) => {
    btn.addEventListener("click", () => {
      const filter = btn.dataset.filter;
      let visible = 0;

      cards.forEach((card) => {
        const show = filter === "all" || card.dataset.category === filter;
        card.hidden = !show;
        card.classList.remove("reveal", "is-visible", "swap");
        if (show) {
          card.style.setProperty("--n", String(visible));
          void card.offsetWidth; // relance l'animation
          card.classList.add("swap");
          visible++;
        }
      });

      buttons.forEach((b) => b.setAttribute("aria-pressed", String(b === btn)));

      if (counter) {
        counter.textContent = `${counter.dataset.showing} ${visible} ${counter.dataset.of} ${counter.dataset.total}`;
      }
    });
  });

  // Halo lumineux qui suit la souris sur chaque ligne de projet
  cards.forEach((card) => {
    card.addEventListener("pointermove", (e) => {
      const r = card.getBoundingClientRect();
      card.style.setProperty("--mx", `${e.clientX - r.left}px`);
      card.style.setProperty("--my", `${e.clientY - r.top}px`);
    });
  });
</script>
