---
import { ui, site, type Lang } from "../i18n/ui";

interface Props {
  lang?: Lang;
}

const { lang = "en" } = Astro.props;
const t = ui[lang];
const home = lang === "fr" ? "/fr/" : "/";

// Le sélecteur de langue reste sur la même page (accueil ou projet)
const path = Astro.url.pathname;
const enPath = path.replace(/^\/fr(?=\/|$)/, "") || "/";
const frPath = enPath === "/" ? "/fr/" : `/fr${enPath}`;
---

<header class="site-header">
  <div class="wrap bar">
    <a class="brand" href={home} aria-label={site.name}>
      <span class="brand-mark">{site.initials}</span>
      <span class="brand-name">{site.name}</span>
    </a>

    <div class="nav">
      <nav class="nav-links" aria-label={t.nav.label}>
        <a href={`${home}#about`}>{t.nav.about}</a>
        <a href={`${home}#projects`}>{t.nav.projects}</a>
        <a href={`${home}#contact`}>{t.nav.contact}</a>
      </nav>

      <div class="tools">
        <div class="lang">
          <a href={enPath} hreflang="en" lang="en" aria-current={lang === "en" ? "true" : undefined}>EN</a>
          <span aria-hidden="true">/</span>
          <a href={frPath} hreflang="fr" lang="fr" aria-current={lang === "fr" ? "true" : undefined}>FR</a>
        </div>

        <button class="theme-btn" type="button" id="theme-toggle" aria-label={t.themeToggle}>
          <svg class="i-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" />
          </svg>
          <svg class="i-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <circle cx="12" cy="12" r="4" />
            <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
          </svg>
        </button>
      </div>
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById("theme-toggle");
  btn?.addEventListener("click", () => {
    const root = document.documentElement;
    const next = root.dataset.theme === "dark" ? "light" : "dark";
    // fondu doux des couleurs pendant ~0,45 s
    root.classList.add("theme-fade");
    root.dataset.theme = next;
    setTimeout(() => root.classList.remove("theme-fade"), 450);
    try {
      localStorage.setItem("theme", next);
    } catch {}
  });
</script>
